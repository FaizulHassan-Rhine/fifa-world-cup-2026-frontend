# Live scores provider: espn (default, free) or football (API-Football)

# VITE_LIVE_PROVIDER=espn



# Football API (dev proxy + Vercel serverless /api/football on THIS frontend project)

API_FOOTBALL_KEY=

API_FOOTBALL_MODE=apisports



# MongoDB predictions backend (Vercel backend project — no trailing slash)

# Production frontend Vercel env:

# VITE_API_BASE_URL=https://fifa-world-cup-2026-backend.vercel.app

# ESPN live data still uses same-site /api/espn on the frontend (not this URL).



# Local dev only: where the Express/MongoDB API runs

# VITE_API_PROXY=http://localhost:3001

