# Live scores provider: espn (default, free) or football (API-Football)
# VITE_LIVE_PROVIDER=espn

# Football API (dev proxy + Vercel serverless /api/football)
API_FOOTBALL_KEY=
API_FOOTBALL_MODE=apisports

# Production: leave unset so ESPN uses same-site /api/espn (Vercel serverless).
# Only set if predictions backend is on another domain:
# VITE_API_BASE_URL=https://your-backend.vercel.app

# Local dev only: where the Express API runs
# VITE_API_PROXY=http://localhost:3001
